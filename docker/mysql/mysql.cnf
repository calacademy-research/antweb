[mysqld]
# To make outdated recent images query work.
sql_mode = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"
group_concat_max_len=15360

# MySQL 8 defaults differ from 5.7; keep 5.7 behaviour for AntWeb's existing tables and code
character-set-server=utf8mb3
collation-server=utf8mb3_general_ci
explicit_defaults_for_timestamp=OFF
# 5.7 had binary logging off; 8.x turns it on (extra GBs of binlog files). No replication here.
skip-log-bin

# To speed up the specimen uploads
innodb_buffer_pool_size=2G
# innodb_log_file_size was replaced by innodb_redo_log_capacity in MySQL 8.0.30
innodb_redo_log_capacity=512M
innodb_buffer_pool_instances=2

skip-external-locking


#log = /var/log/mysqld.log


# This breaks mysql
#log-output = FILE
#
#... and ...

[mysqldump]
quick
max_allowed_packet = 16M

[mysqlhotcopy]
interactive-timeout


#
# The MySQL database server configuration file.
#
# You can copy this to one of:
# - "/etc/mysql/my.cnf" to set global options,
# - "~/.my.cnf" to set user-specific options.
#
# One can use all long options that the program supports.
# Run program with --help to get a list of available options and with
# --print-defaults to see which it would actually understand and use.
#
# For explanations see
# http://dev.mysql.com/doc/mysql/en/server-system-variables.html

#
# * IMPORTANT: Additional settings that can override those from this file!
#   The files must end with '.cnf', otherwise they'll be ignored.
#

#!includedir /etc/mysql/conf.d/
#!includedir /etc/mysql/mysql.conf.d/
