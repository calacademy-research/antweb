<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE web-app
        PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app>

    <!-- Define application events listeners -->
    <listener>
      <listener-class>
        org.calacademy.antweb.util.AppContextListener
      </listener-class>
    </listener>

  <!-- Standard Action Servlet Configuration (with debugging) -->
  <servlet>
    <servlet-name>action</servlet-name>
    <servlet-class>org.apache.struts.action.ActionServlet</servlet-class>
    <init-param>
      <param-name>config</param-name>
      <param-value>/WEB-INF/struts-config.xml</param-value>
    </init-param>
    <init-param>
      <param-name>validate</param-name>
      <param-value>true</param-value>
    </init-param>
    <load-on-startup>2</load-on-startup>
  </servlet>

  <!-- Standard Action Servlet Mapping -->
  <servlet-mapping>
    <servlet-name>action</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>

<!-- Static files. Folders are never listed: a folder URL without a welcome file is a 404.
     Curators see their own folder through /curatorFiles.do. -->
<servlet>
  <servlet-name>DirectoryListing</servlet-name>
  <servlet-class>org.apache.catalina.servlets.DefaultServlet</servlet-class>
  <init-param>
    <param-name>debug</param-name>
    <param-value>0</param-value>
  </init-param>
  <init-param>
    <param-name>listings</param-name>
    <param-value>false</param-value>
  </init-param>
</servlet>

<servlet-mapping>
  <servlet-name>DirectoryListing</servlet-name>
  <url-pattern>/</url-pattern>
</servlet-mapping>

<!--  http://www.antweb.org/specimen/casent1  will return
      http://www.antweb.org/specimen.do?code=casent1  -->
  <servlet>
    <servlet-name>SpecimenFetch</servlet-name>
    <servlet-class>org.calacademy.antweb.util.SpecimenFetch</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>SpecimenFetch</servlet-name>
    <url-pattern>/specimen/*</url-pattern>
  </servlet-mapping>


<error-page>
  <exception-type>java.lang.Throwable</exception-type>
  <location>/error </location>
</error-page>

<servlet>
  <servlet-name>exceptionServlet</servlet-name>
  <servlet-class>org.calacademy.antweb.util.CustomExceptionServlet</servlet-class>
  <load-on-startup>3</load-on-startup>
</servlet>

<servlet-mapping>
  <servlet-name>exceptionServlet</servlet-name>
  <url-pattern>/error</url-pattern>
</servlet-mapping>

  <!-- Struts Tag Library Descriptors -->
  <taglib>
    <taglib-uri>/WEB-INF/struts-bean.tld</taglib-uri>
    <taglib-location>/WEB-INF/struts-bean.tld</taglib-location>
  </taglib>

  <taglib>
    <taglib-uri>/WEB-INF/struts-html.tld</taglib-uri>
    <taglib-location>/WEB-INF/struts-html.tld</taglib-location>
  </taglib>

  <taglib>
    <taglib-uri>/WEB-INF/struts-logic.tld</taglib-uri>
    <taglib-location>/WEB-INF/struts-logic.tld</taglib-location>
  </taglib>

<taglib>
  <taglib-uri>/WEB-INF/struts-tiles.tld</taglib-uri>
  <taglib-location>/WEB-INF/struts-tiles.tld</taglib-location>
</taglib>


    <!-- cache static files --> 

    <filter>
       <filter-name>ExpiresFilter</filter-name>
       <filter-class>org.apache.catalina.filters.ExpiresFilter</filter-class>
       <init-param>
          <param-name>ExpiresByType image</param-name>
          <param-value>access plus 1 year</param-value>
       </init-param>
       <init-param>
          <param-name>ExpiresByType text/css</param-name>
          <param-value>access plus 1 month</param-value>
       </init-param>
       <init-param>
          <param-name>ExpiresByType application/javascript</param-name>
          <param-value>access plus 1 month</param-value>
       </init-param>
    </filter>
    <filter-mapping>
       <filter-name>ExpiresFilter</filter-name>
      <url-pattern>/image/*</url-pattern>
      <url-pattern>/images/*</url-pattern>
      <url-pattern>/common/*</url-pattern>
      <url-pattern>/search/*</url-pattern>
      <url-pattern>/ckeditor/*</url-pattern>
       <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Cache lifetime of local scripts and stylesheets: 1 year for file.js?v=hash
         (pages write these, see util/Asset), 1 day without ?v=. Must stay mapped AFTER
         ExpiresFilter, which then leaves these responses alone. -->
    <filter>
       <filter-name>AssetCacheFilter</filter-name>
       <filter-class>org.calacademy.antweb.util.AssetCacheFilter</filter-class>
    </filter>
    <filter-mapping>
       <filter-name>AssetCacheFilter</filter-name>
       <url-pattern>*.js</url-pattern>
       <url-pattern>*.css</url-pattern>
       <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- "Keep me logged in" (AW_REMEMBER cookie) on the home page and other directly opened JSPs.
         SessionRequestFilter below does the same for *.do. REQUEST only: JSPs that actions
         forward to are already covered. Returns at once without the cookie. -->
    <filter>
        <filter-name>RememberMeFilter</filter-name>
        <filter-class>org.calacademy.antweb.util.RememberMeFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RememberMeFilter</filter-name>
        <url-pattern>/</url-pattern>
        <url-pattern>*.jsp</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Here we can insert code that should be run for every request. -->
    <filter>
        <filter-name>SessionRequestFilter</filter-name>
        <filter-class>org.calacademy.antweb.util.SessionRequestFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SessionRequestFilter</filter-name>
        <url-pattern>*.do</url-pattern>
        <dispatcher>REQUEST</dispatcher>        
    </filter-mapping>

    <!-- Never compile/run a .jsp in the run-time directories (upload reports, logs,
         curator files, generated includes). Old .jsp reports in /web/log/ are sent
         as sandboxed, uncompiled HTML. -->
    <filter>
        <filter-name>GeneratedJspFilter</filter-name>
        <filter-class>org.calacademy.antweb.util.GeneratedJspFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>GeneratedJspFilter</filter-name>
        <url-pattern>/web/log/*</url-pattern>
        <url-pattern>/web/upload/*</url-pattern>
        <url-pattern>/web/genInc/*</url-pattern>
        <url-pattern>/web/curator/*</url-pattern>
        <url-pattern>/web/workingdir/*</url-pattern>
        <url-pattern>/web/data/*</url-pattern>
        <url-pattern>/web/bak/*</url-pattern>
        <url-pattern>/workingDir/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </filter-mapping>

  <session-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <resource-ref>
    <description>DB Connection</description>
    <res-ref-name>jdbc/AntSource</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-link>jdbc/AntSource</res-link>
  </resource-ref>

</web-app>
