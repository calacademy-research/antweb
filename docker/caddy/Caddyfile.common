# Browser security headers (2026-10-15). Cloudflare's "Allow AntCat.org to Embed" rule
# still removes X-Frame-Options for requests coming from antcat.org.
header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
}

@bots {
   header_regexp User-Agent "(?i)(CCBot|Googlebot-Images|Sogou|SenutoBot|SiteScoreBot|Twitterbot|YisouSpider|IABot|Turnitin|'CFNetwork/.* Darwin'|ClaudeBot|SemrushBot|Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Sogou|Exabot|facebot|facebookexternalhit|Bytespider|AppleBot|Swiftbot|Slurp Bot|CCBot|GoogleOther|Google-InspectionTool|MJ12bot|Alexa crawler|Soso Spider|Pinterestbot|Dotbot|AhrefsBot|archive.org_bot|scrapy|PetalBot|SemrushBot|Amazonbot|DataForSeoBot)"
}

@allowed_paths {
    path /
    path *.pdf
    path *.xls
    path *.xlsx
    path *.html
    path *.css
    path *.ico
    path *.jsp
    path *.do
    path *.jpg
    path *.jpeg
    path *.gif
    path *.png
    path *.js
    path *.txt
    path *.log
    path *.js

    # directories (file requests under images/ are redirected to the image bucket above)
    path /images/*

    path /web/curator/*
    path /web/log/*
    path /specimen/*
    path /web/bak/taxonSets/*
}


@static_images {
    path_regexp image_file ^/images/(.+\..+)$
}

# Directive in route block are evaluated in order
route {
    respond @bots "Access Denied" 403 {
        close
    }

    redir @static_images {$IMAGE_BUCKET_DOMAIN}{uri}

    # Never served: Tomcat admin apps, database dumps, private logs, working files,
    # raw exception logs. (Same list as prod's Caddyfile.)
    @denied_paths {
        path /manager /manager/* /host-manager /host-manager/*
        path /backup /backup/* /log /log/* /logbak /logbak/*
        path /web/workingdir /web/workingdir/* /web/log/srf* /web/log/bak /web/log/bak/*
        path /workingDir /workingDir/* /web/log/getUrl* /web/log/accessLog* /web/log/insecure* /staff_gen_inc.jsp
        path /WEB-INF/* /META-INF/*
        # Archived upload files: curators download them through /uploadFile.do.
        path /web/upload /web/upload/*
    }
    respond @denied_paths "Not found" 404
    # Logs under /web/log/ are read by admins through /logMgr.do. Only the upload report
    # folders stay public (group and upload pages link to those reports).
    @private_logs {
        path /web/log /web/log/*
        not path /web/log/upload/* /web/log/specimen/* /web/log/worldants/* /web/log/detail/*
    }
    respond @private_logs "Not found" 404

    # A ";" in the path (or its encoded form %3B) is never needed here, and Tomcat strips
    # ";..." from a path while Caddy does not, which could slip past the lists above.
    @path_params expression {http.request.uri}.matches("(?i)^[^?]*(;|%3b)")
    respond @path_params "Not found" 404

    # Login records (who logged in, when): admins read them through /logMgr.do.
    respond /web/log/logins* "Not found" 404
    # Admin actions log (who did what, by login id): admins read it through /logMgr.do.
    respond /web/log/admin* "Not found" 404
    # Server-busy reports (running SQL, request URLs) and page messages: not public; both are now data logs.
    respond /web/log/serverBusy* "Not found" 404
    respond /web/log/messages* "Not found" 404
    # Test JSPs under /data/ (e.g. the old encoding test page) are never public.
    respond /data/*.jsp "Not found" 404
    # Folder URLs (ending in /) under these trees are never served. Tomcat does not list
    # folders either; curators see their own folder through /curatorFiles.do.
    @dir_listings path_regexp ^/(images|web/log|web/curator|web/bak)(/.*)?/$
    respond @dir_listings "Not found" 404


    # Logins: at most 10 attempts a minute per visitor (password guessing).
    # Cloudflare sits in front, so the visitor is CF-Connecting-IP.
    @login_post {
        method POST
        path /login.do
    }
    rate_limit @login_post {
        zone logins {
            key {http.request.header.CF-Connecting-IP}-{http.request.remote.host}
            window 1m
            events 10
        }
    }

    handle_path /v3.1/* {
        reverse_proxy api:5000
    }

    # Direct *.jsp requests (cleanup batch 2, 2026-10): only the JSPs below reach Tomcat; any other
    # *.jsp is a 404 here. Pages are reached through .do actions, which forward to their JSPs
    # inside Tomcat without passing Caddy, so this does not affect them. The list is the JSPs
    # people request directly (production traffic) plus every JSP the site's own pages link,
    # redirect to or load. Keep the list the same in Caddyfile and Caddyfile.common (CI checks;
    # tests/e2e/test_jsp_allow_list.py tests it on staging).
    @jsp_not_allowed {
        path *.jsp *.jspx *.jspf
        not path /index.jsp /about.jsp /citing_antweb.jsp /user_guide.jsp /search.jsp
        not path /countries.jsp /imagePage.jsp /bigPicture.jsp /mapComparison.jsp /dynamicMap.jsp
        not path /berlin.jsp /geneva.jsp /genoa.jsp /basel.jsp /oxford.jsp /copenhagen.jsp /paraguay.jsp
        not path /login.jsp /forgot_password.jsp /notLoggedIn.jsp /permissionDenied.jsp /error.jsp
        not path /common/statusDisplayPage.jsp /common/casteDisplayPage.jsp /common/distStatusDisplayPage.jsp
        not path /search/loading_search_results_data.jsp /search/autoCompleteKeys.jsp
        not path /search/autoCompletePlaceKeys.jsp /search/multiTaxaOneView.jsp
        not path /documentation/api/apiV3_1.jsp /documentation/releaseNotes.jsp
        not path /web/speciesList/*/*.jsp
        # Old upload reports and logs; Tomcat sends these as plain, sandboxed text (GeneratedJspFilter).
        not path /web/log/*
    }
    respond @jsp_not_allowed "Not found" 404

    reverse_proxy @allowed_paths antweb:8080

    # Any request that doesn't match one of the proxies gets a 404 response
    error "Not found" 404
}

log {
    output file /var/log/caddy/access.log
    format console      # give one-liners, not json
}
