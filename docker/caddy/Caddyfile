{
    order rate_limit before basicauth

    default_sni www.antweb.org
    servers {
        # dmz-shield files live only on prod (caddy_config volume, /config/dmz-shield).
        # The * makes this a glob, so Caddy skips it quietly where the file is absent.
        import /config/dmz-shield/servers*.caddy
        timeouts {
            read_body 45m
            read_header 45m
            write 45m
            idle 45m
        }
    }
}

antweb.org {
    tls /data/cf-origin.crt /data/cf-origin.key
    redir https://www.antweb.org{uri}
}

api.antweb.org {
    tls /data/cf-origin.crt /data/cf-origin.key
    redir https://www.antweb.org{uri} permanent
}

www.antweb.org {
    tls /data/cf-origin.crt /data/cf-origin.key
    # Browser security headers (2026-10-15). Cloudflare's "Allow AntCat.org to Embed" rule
    # still removes X-Frame-Options for requests coming from antcat.org.
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @bots {
        header_regexp User-Agent "(?i)(CCBot|GPTBot|Googlebot-Images|Sogou|SenutoBot|SiteScoreBot|Twitterbot|YisouSpider|IABot|Turnitin|CFNetwork/.* Darwin|ClaudeBot|SemrushBot|Googlebot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Sogou|Exabot|facebot|facebookexternalhit|Bytespider|AppleBot|Swiftbot|Slurp Bot|GoogleOther|Google-InspectionTool|MJ12bot|Alexa crawler|Soso Spider|Pinterestbot|Dotbot|AhrefsBot|archive.org_bot|scrapy|PetalBot|Amazonbot|DataForSeoBot|Yeti|Googlebot-Image|meta-externalagent)"
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 100MiB
            roll_keep 10
#            roll_keep_days 1
        }
        format json
#        format console
    }

    @static_images {
        path_regexp image_file ^/images/(.+\..+)$
    }

    route {
        import /config/dmz-shield/banned*.caddy

        respond @bots "Access Denied" 403 {
            close
        }

        redir @static_images {$IMAGE_BUCKET_DOMAIN}{uri}

        # Never served: Tomcat admin apps, database dumps, private logs, working files,
        # raw exception logs. (Checked first, so the allow-list below cannot let them through.)
        @denied_paths {
            path /manager /manager/* /host-manager /host-manager/*
            path /backup /backup/* /log /log/* /logbak /logbak/*
            path /web/workingdir /web/workingdir/* /web/log/srf* /web/log/bak /web/log/bak/*
            path /workingDir /workingDir/* /web/log/getUrl* /web/log/accessLog* /web/log/insecure* /staff_gen_inc.jsp
            path /WEB-INF/* /META-INF/*
        }
        respond @denied_paths "Not found" 404

        # A ";" in the path (or its encoded form %3B) is never needed here, and Tomcat strips
        # ";..." from a path while Caddy does not, which could slip past the lists above.
        @path_params expression {http.request.uri}.matches("(?i)^[^?]*(;|%3b)")
        respond @path_params "Not found" 404

        # Login records (who logged in, when): admins read them through /logMgr.do.
        respond /web/log/logins* "Not found" 404
        # Admin actions log (who did what, by login id): admins read it through /logMgr.do.
        respond /web/log/admin* "Not found" 404
        # Server-busy reports (running SQL, request URLs): not public; the report is now a data log.
        respond /web/log/serverBusy* "Not found" 404
        # Test JSPs under /data/ (e.g. the old encoding test page) are never public.
        respond /data/*.jsp "Not found" 404
        # Directory listings of all logs, all curator folders and the taxon-set backups.
        @dir_listings path /web/log/ /web/curator/ /web/bak/taxonSets/
        respond @dir_listings "Not found" 404

        # Logins: at most 10 attempts a minute per visitor (password guessing).
        # Cloudflare sits in front, so the visitor is CF-Connecting-IP.
        @login_post {
            method POST
            path /login.do
        }
        rate_limit @login_post {
            zone logins {
                key {http.request.header.CF-Connecting-IP}-{http.request.remote.host}
                window 1m
                events 10
            }
        }

        handle_path /v3.1/* {
            reverse_proxy api:5000 {
                header_up X-Forwarded-For {http.request.remote.host}
            }
        }

        # Only these paths reach Tomcat (same list as staging's Caddyfile.common);
        # anything else falls through to the 404 below.
        @allowed_paths {
            path / *.do *.jsp *.html *.css *.js *.txt *.log *.pdf *.xls *.xlsx
            path *.ico *.jpg *.jpeg *.gif *.png *.svg *.woff *.woff2 *.ttf *.xml *.xsl
            path /images/* /web/curator/* /web/log/* /specimen/* /web/bak/taxonSets/*
        }
        reverse_proxy @allowed_paths antweb:8080 {
            header_up X-Forwarded-For {http.request.remote.host}
        }

        error "Not found" 404

        @not_upload {
            not path /upload.do
        }
        rate_limit @not_upload {
            zone requests {
                key {http.request.remote.host}
                window 1m
                events 10
                burst 20
            }
        }
    }
}
